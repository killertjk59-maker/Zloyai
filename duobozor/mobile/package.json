{
  "name": "duobozor",
  "version": "1.1.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --no-install",
    "apk": "cd android && ./gradlew assembleRelease",
    "test": "node test/logic.test.mjs",
    "ios": "expo run:ios",
    "test:ui": "jest --ci --silent"
  },
  "dependencies": {
    "@expo/vector-icons": "14.0.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~51.0.28",
    "expo-font": "12.0.10",
    "expo-linear-gradient": "~13.0.2",
    "expo-splash-screen": "~0.27.7",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.4",
    "react-test-renderer": "^18.2.0"
  },
  "overrides": {
    "expo-font": "12.0.10"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/test/**/*.ui.test.js"
    ],
    "setupFiles": [
      "<rootDir>/test/setup.js"
    ]
  }
}
