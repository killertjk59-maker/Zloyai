# ── Secrets (never commit these) ─────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
key.properties
*.jks
*.keystore
android/key.properties

# ── Flutter / Dart ───────────────────────────────────────────────────────────
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
