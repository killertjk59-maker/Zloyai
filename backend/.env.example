# ─────────────────────────────────────────────────────────────────────────────
# ZLOY.AI backend — copy this file to `.env` and fill in your own values.
#
#   cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed. Real API keys belong only
# in this file locally, or in your host's environment-variable dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# development | staging | production | test
APP_ENV=development
LOG_LEVEL=INFO

# auto       -> OpenRouter if OPENROUTER_API_KEY is set, otherwise mock
# openrouter -> always OpenRouter (returns 503 provider_not_configured without a key)
# mock       -> deterministic local rule engine, no network, answers labelled "mock"
AI_PROVIDER=auto

# Get a key at https://openrouter.ai/keys (free models are marked ":free").
# Leave empty to run entirely on the mock provider.
OPENROUTER_API_KEY=

# Free model IDs rotate. Check the live list before choosing one:
#   curl -s https://openrouter.ai/api/v1/models | grep ':free'
# or:  curl -s http://localhost:8000/api/v1/models/free
OPENROUTER_MODEL=google/gemma-4-31b-it:free

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_TOKENS=900
OPENROUTER_TEMPERATURE=0.6

# Optional attribution headers (openrouter.ai leaderboard). Public URLs only.
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=ZLOY.AI

# Comma-separated allow-list. Empty = "*" (safe here: no cookies, no credentials).
# Native Android clients send no Origin header, so "*" is the normal setting.
CORS_ORIGINS=

MAX_MESSAGE_CHARS=600
MAX_HISTORY_MESSAGES=10

# Per-client request budget, to protect the shared model quota.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# SQLite file for future server-side features; the app's own progress is local.
DATABASE_URL=sqlite:///./zloy.db
